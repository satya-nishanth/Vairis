# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage — STORAGE_PROVIDER=azure opts admin uploads into Azure Blob instead of
# Supabase Storage (Azure migration, staging-only for now). Defaults to supabase.
STORAGE_PROVIDER=supabase
AZURE_STORAGE_ACCOUNT_NAME=

# Database (Prisma) — use port 5432 direct URL for migrations
DATABASE_URL=

# Payments — PAYMENT_GATEWAY=mock for keyless dev/e2e (full lifecycle via
# /mock-pay); switch to razorpay + real keys at launch. Mock refuses to run
# on Vercel production unless ALLOW_MOCK_PAYMENTS=true.
PAYMENT_GATEWAY=mock
NEXT_PUBLIC_CHECKOUT_ENABLED=true
# MOCK_PAYMENT_SECRET=change-me           # optional, HMAC for mock webhooks

# Razorpay (launch)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Shipping — SHIPPING_PROVIDER=manual|shiprocket|dtdc|sequel247.
# SHIPPING_MOCK=true makes shiprocket/dtdc/sequel247 return fixtures (keyless dev/e2e).
SHIPPING_PROVIDER=sequel247
SHIPPING_MOCK=true

# Shiprocket (launch)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# DTDC (alternative partner)
DTDC_API_KEY=
DTDC_CUSTOMER_CODE=
DTDC_SERVICE_TYPE=B2C PRIORITY

# Sequel247 (chosen delivery partner) — token/base URL from the Sequel
# Team's onboarding email. UAT for stage testing, prod once BIS-cert /
# go-live is ready.
SEQUEL247_TOKEN=
SEQUEL247_BASE_URL=https://test.sequel247.com
SEQUEL247_STORE_CODE=HYDVFJ

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@thevairis.com

# Admin (comma-separated emails)
ADMIN_EMAILS=anil@thevairis.com,nishi@thevairis.com

# Internal API (WhatsApp bot)
INTERNAL_API_KEY=

# Cron auth (any random string — set same value in Vercel env vars)
CRON_SECRET=

# Gold Price API (GoldAPI.io)
GOLD_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics (GA4) — optional
NEXT_PUBLIC_GA_ID=

# Error tracking (Sentry) — optional; unset = no-op, zero overhead
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
