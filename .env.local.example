# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage — STORAGE_PROVIDER=azure opts admin uploads into Azure Blob instead of
# Supabase Storage (Azure migration, staging-only for now). Defaults to supabase.
STORAGE_PROVIDER=supabase
AZURE_STORAGE_ACCOUNT_NAME=

# Database (Prisma) — use port 5432 direct URL for migrations
DATABASE_URL=

# Payments — PAYMENT_GATEWAY=mock for keyless dev/e2e (full lifecycle via
# /mock-pay); switch to razorpay + real keys at launch. Mock refuses to run
# on Vercel production unless ALLOW_MOCK_PAYMENTS=true.
PAYMENT_GATEWAY=mock
NEXT_PUBLIC_CHECKOUT_ENABLED=true
# MOCK_PAYMENT_SECRET=change-me           # optional, HMAC for mock webhooks

# Razorpay (launch)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Shipping — SHIPPING_PROVIDER=manual|shiprocket|dtdc.
# SHIPPING_MOCK=true makes shiprocket/dtdc return fixtures (keyless dev/e2e).
SHIPPING_PROVIDER=shiprocket
SHIPPING_MOCK=true

# Shiprocket (launch)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# DTDC (alternative partner)
DTDC_API_KEY=
DTDC_CUSTOMER_CODE=
DTDC_SERVICE_TYPE=B2C PRIORITY

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@thevairis.com

# Admin (comma-separated emails)
ADMIN_EMAILS=anil@thevairis.com,nishi@thevairis.com

# Internal API (bot <-> store) — used by /api/internal/quotations*
INTERNAL_API_KEY=

# Quotation pipeline — Discord thread creation + assignee ping (Next.js side)
DISCORD_BOT_TOKEN=
DISCORD_QUOTE_CHANNEL_ID=
DISCORD_QUOTE_ASSIGNEE_ID=
# Server for the "View Discord thread" deep-link on /admin/quotations/[id] —
# https://discord.com/channels/{guild}/{thread}. Optional: link is omitted if unset.
DISCORD_GUILD_ID=
# Dashboard-only staleness threshold for a QUOTED-but-not-converted quotation (hours). No pings —
# visibility only, per the hardening pass in the design doc.
QUOTE_STALE_QUOTED_HOURS=24

# Cron auth (any random string — set same value in Vercel env vars)
CRON_SECRET=

# Gold Price API (GoldAPI.io)
GOLD_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics (GA4) — optional
NEXT_PUBLIC_GA_ID=

# Error tracking (Sentry) — optional; unset = no-op, zero overhead
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
