generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase requires direct connection URL for migrations (not the pooler)
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Category {
  RINGS
  EARRINGS
  PENDANTS
  BRACELETS
  NECKLACES
}

enum MetalType {
  GOLD_14K
  GOLD_18K
  ROSE_GOLD
}

enum OrderStatus {
  PAYMENT_PENDING
  PAYMENT_EXPIRED
  PAYMENT_CONFIRMED
  PREPARING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERY_FAILED
  RETURNING_TO_ORIGIN
  RTO_RECEIVED
  DELIVERED
  DEPOSIT_REFUNDED
  RETURN_REQUESTED
  RETURN_IN_TRANSIT
  RETURN_RECEIVED
  CANCELLED
  REFUNDED
  SPLIT_INTO_DELIVERIES
  FAILED_OTHER
}

enum RefundKind {
  DEPOSIT
  FULL
  PARTIAL
}

enum RefundMethod {
  GATEWAY
  OFFLINE
}

enum RefundStatus {
  INITIATED
  COMPLETED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  mobile    String?
  googleId  String?    @unique
  createdAt DateTime   @default(now())
  addresses Address[]
  orders    Order[]
  cartItems CartItem[]
  wishlists Wishlist[]
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
}

model Product {
  id          String           @id @default(cuid())
  name        String
  description String
  category    Category
  images      String[]
  basePrice   Decimal          @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())

  // Design identity
  itemCode    String?          @unique
  designStyle String?

  // Physical dimensions
  totalLengthMm Decimal?
  motifSizeMm   Decimal?
  thicknessMm   Decimal?

  // Gemstone details
  stoneType   String?
  stoneShape  String?
  stoneDimMm  String?
  gemCount    Int?
  caratWeight Decimal?

  comingSoon  Boolean          @default(false)

  variants    ProductVariant[]
  wishlists   Wishlist[]
}

model ProductVariant {
  id                  String      @id @default(cuid())
  productId           String
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  metalType           MetalType
  size                String?
  weightGrams         Decimal
  makingChargePerGram Decimal     @default(0)
  flatMakingCharge    Decimal     @default(0)
  stoneCharges        Decimal     @default(0)
  miscCharges         Decimal     @default(0)
  stock               Int         @default(0)
  sku                 String      @unique
  cartItems           CartItem[]
  orderItems          OrderItem[]
}

model GoldRate {
  metalType   MetalType
  ratePerGram Decimal
  fetchedAt   DateTime  @updatedAt

  @@id([metalType])
}

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@unique([userId, variantId])
}

model Order {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  items         OrderItem[]
  status        OrderStatus  @default(PAYMENT_PENDING)
  totalAmount   Decimal
  // Jewellery deposit model: customer pays grandTotal = totalAmount * 1.05,
  // depositAmount (5%) is refunded after delivery
  depositAmount Decimal      @default(0)
  grandTotal    Decimal      @default(0)
  contactName   String       @default("")
  contactPhone  String       @default("")
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  pincode       String
  payment       Payment?
  events        OrderEvent[]
  parentOrderId String?
  parent        Order?       @relation("OrderSplit", fields: [parentOrderId], references: [id])
  children      Order[]      @relation("OrderSplit")
  refunds       OrderRefund[]
  notes         OrderNote[]
  shipments     Shipment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id])
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int
  price       Decimal
  productName String
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpayRefundId  String?
  refundedAmount    Decimal       @default(0)
  status            PaymentStatus @default(CREATED)
  amount            Decimal
  createdAt         DateTime      @default(now())
}

model Shipment {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id])
  shiprocketId String?
  awbCode      String?
  courierName  String?
  trackingUrl  String?
  status       String?
  attempts     Int       @default(0)
  outcome      String?   // DELIVERED | FAILED | RTO — null while in flight
  dispatchedAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([orderId, dispatchedAt])
}

model OrderRefund {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id])
  amount          Decimal
  kind            RefundKind
  method          RefundMethod
  gatewayRefundId String?      @unique
  reason          String
  status          RefundStatus @default(INITIATED)
  createdAt       DateTime     @default(now())

  @@index([orderId])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author    String
  body      String
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model SiteBanner {
  id        String   @id @default(cuid())
  slot      String   @unique
  title     String?
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  ctaLabel  String?
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ── Catalogue reel (Instagram-style) ─────────────────────────────────────────

model GuestUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  phone        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  progress  CatalogueProgress?
  reactions CatalogueReaction[]
  comments  CatalogueComment[]
}

model CatalogueProgress {
  id             String    @id @default(cuid())
  guestUserId    String    @unique
  guestUser      GuestUser @relation(fields: [guestUserId], references: [id], onDelete: Cascade)
  lastFrameIndex Int       @default(-1)
  updatedAt      DateTime  @updatedAt
}

model CatalogueReaction {
  id          String    @id @default(cuid())
  guestUserId String
  guestUser   GuestUser @relation(fields: [guestUserId], references: [id], onDelete: Cascade)
  productId   String
  reaction    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([guestUserId, productId])
}

model CatalogueComment {
  id          String    @id @default(cuid())
  guestUserId String
  guestUser   GuestUser @relation(fields: [guestUserId], references: [id], onDelete: Cascade)
  productId   String
  body        String
  createdAt   DateTime  @default(now())
}
