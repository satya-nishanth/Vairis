generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase requires direct connection URL for migrations (not the pooler)
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Category {
  RINGS
  EARRINGS
  PENDANTS
  BRACELETS
  NECKLACES
}

/// Gold purity (karat). Used for GoldRate lookup — color is separate.
enum MetalType {
  GOLD_9K
  GOLD_14K
  GOLD_18K
  GOLD_22K
}

/// Alloy color — does not affect gold rate.
enum MetalColor {
  YELLOW
  WHITE
  ROSE
}

enum ProductStatus {
  DRAFT
  AI_DRAFT
  LIVE
}

enum OrderStatus {
  PAYMENT_PENDING
  PAYMENT_EXPIRED
  PAYMENT_CONFIRMED
  PREPARING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERY_FAILED
  RETURNING_TO_ORIGIN
  RTO_RECEIVED
  DELIVERED
  DEPOSIT_REFUNDED
  RETURN_REQUESTED
  RETURN_IN_TRANSIT
  RETURN_RECEIVED
  CANCELLED
  REFUNDED
  SPLIT_INTO_DELIVERIES
  FAILED_OTHER
}

enum RefundKind {
  DEPOSIT
  FULL
  PARTIAL
}

enum RefundMethod {
  GATEWAY
  OFFLINE
}

enum RefundStatus {
  INITIATED
  COMPLETED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  mobile    String?
  googleId  String?    @unique
  createdAt DateTime   @default(now())
  addresses Address[]
  orders    Order[]
  cartItems CartItem[]
  wishlists Wishlist[]
  reviews   Review[]
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  label        String? // "Home", "Office"
  contactName  String   @default("")
  contactPhone String   @default("")
  line1        String
  line2        String?
  city         String
  state        String
  pincode      String
  country      String   @default("IN") // "IN" = domestic; free text otherwise
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Product {
  id          String           @id @default(cuid())
  name        String
  description String
  category    Category
  images      String[]
  basePrice   Decimal          @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())

  // Design identity
  itemCode    String?          @unique
  designStyle String?

  // Physical dimensions
  totalLengthMm Decimal?
  motifSizeMm   Decimal?
  thicknessMm   Decimal?

  // Gemstone details
  stoneType   String?
  stoneShape  String?
  stoneDimMm  String?
  gemCount    Int?
  caratWeight Decimal?

  comingSoon  Boolean          @default(false)
  status      ProductStatus    @default(DRAFT)
  priority    Int              @default(0)
  /// Per-product override of PricingSettings.showPricesGlobal. INHERIT (default)
  /// follows the global toggle; SHOW/HIDE always win regardless of it.
  priceVisibility PriceVisibility @default(INHERIT)

  /// Null = inherit store PricingSettings.vaGoldPct / vaLabel.
  /// Prefer per-piece overrides on ProductPiece when present.
  vaGoldPct   Decimal?
  vaLabel     String?

  pieces      ProductPiece[]
  variants    ProductVariant[]
  stones      ProductStone[]
  wishlists   Wishlist[]
  reviews     Review[]
  collections CollectionProduct[]
  storeCategories StoreCategoryProduct[]
  inventoryItems InventoryItem[]
  automaticDiscountProducts AutomaticDiscountProduct[]
  promoCodeProducts         PromoCodeProduct[]
  tags        ProductTag[]
}

/// A sellable piece within a product (e.g. Necklace + Earrings in a set).
/// Single-item products have one piece. Each piece has its own variants & stones.
enum ProductTagGroup {
  TYPE
  OCCASION
}

/// PLP filter tag on a product (Type / Occasion). Option lists live in CategoryFilterConfig.
model ProductTag {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     ProductTagGroup
  value     String

  @@unique([productId, group, value])
  @@index([group, value])
}

/// Ordered PLP filter option lists per category slug (admin-editable).
model CategoryFilterConfig {
  categorySlug String   @id
  categoryName String?
  types        String[]
  occasions    String[]
  updatedAt    DateTime @updatedAt
}

model ProductPiece {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   @default("Main")
  sortOrder Int      @default(0)
  /// Null = inherit Product.vaGoldPct / store PricingSettings.
  vaGoldPct Decimal?
  vaLabel   String?
  variants  ProductVariant[]
  stones    ProductStone[]

  @@index([productId, sortOrder])
}

/// Per-carat diamond pricing — one row per diamond type, two rates each
/// (with / without exchange). Admin-editable at /admin/settings/pricing.
model DiamondRate {
  id                   String         @id @default(cuid())
  code                 String         @unique
  label                String
  ratePerCarat         Decimal
  ratePerCaratExchange Decimal
  sortOrder            Int            @default(0)
  active               Boolean        @default(true)
  updatedAt            DateTime       @updatedAt
  stones               ProductStone[]
}

/// A stone entry on a product: type + carat (+ optional count/label).
/// Customer always sees type + carat; count/label optional.
model ProductStone {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  pieceId       String?
  piece         ProductPiece? @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  diamondRateId String
  diamondRate   DiamondRate @relation(fields: [diamondRateId], references: [id])
  caratWeight   Decimal
  count         Int?
  label         String?
  /// Null = use DiamondRate store defaults for this type.
  ratePerCarat         Decimal?
  ratePerCaratExchange Decimal?
  sortOrder     Int         @default(0)

  @@index([productId, sortOrder])
  @@index([pieceId, sortOrder])
}

/// Singleton (id=1). Wastage = disclosed % on gold value only. Label admin-editable.
model PricingSettings {
  id         Int      @id @default(1)
  vaGoldPct  Decimal  @default(10)
  vaStonePct Decimal  @default(0)
  vaLabel    String   @default("Value Addition")
  /// Store defaults for first-class fixed fees. Null on ProductVariant = inherit these amounts.
  defaultCertificationCharges Decimal @default(0)
  defaultPackagingCharges     Decimal @default(0)
  defaultDeliveryCharges      Decimal @default(0)
  /// Customer-facing labels for the three fixed fees (PDP, orders, invoices).
  certificationLabel String @default("Certification")
  packagingLabel     String @default("Packaging")
  deliveryLabel      String @default("Delivery")
  /// Storefront-wide default for whether prices are shown at all. Many
  /// products (no finalized diamond/gold cost yet) should read
  /// "Price on Request" instead of a computed number — Product.priceVisibility
  /// can override this per product.
  showPricesGlobal Boolean @default(true)
  updatedAt  DateTime @updatedAt
}

enum PriceVisibility {
  INHERIT
  SHOW
  HIDE
}

model ProductVariant {
  id                  String      @id @default(cuid())
  productId           String
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  pieceId             String?
  piece               ProductPiece? @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  metalType           MetalType
  metalColor          MetalColor  @default(YELLOW)
  size                String?
  weightGrams         Decimal
  makingChargePerGram Decimal     @default(0)
  flatMakingCharge    Decimal     @default(0)
  stoneCharges        Decimal     @default(0)
  /// Sum of miscChargeLines (or legacy flat amount). Used by pricing.
  miscCharges         Decimal     @default(0)
  /// Labeled misc rows: [{ label, amount }]. Null/empty = no misc lines (do not invent Hallmark).
  miscChargeLines     Json?
  /// Fixed fees (₹) — disclosed like gold / GST. Null = inherit PricingSettings defaults.
  certificationCharges Decimal?
  packagingCharges     Decimal?
  deliveryCharges      Decimal?
  stock               Int         @default(0)
  sku                 String      @unique
  cartItems           CartItem[]
  orderItems          OrderItem[]
  inventoryItems      InventoryItem[]

  @@index([pieceId])
  @@index([productId, metalType, metalColor])
}

model GoldRate {
  metalType   MetalType
  ratePerGram Decimal
  fetchedAt   DateTime  @updatedAt

  @@id([metalType])
}

model CartItem {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  quantity     Int
  withExchange Boolean        @default(false)

  @@unique([userId, variantId, withExchange])
}

model Order {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  items              OrderItem[]
  status             OrderStatus   @default(PAYMENT_PENDING)
  promoCodeId        String?
  promoCode          PromoCode?    @relation(fields: [promoCodeId], references: [id])
  discountAmount     Decimal       @default(0)
  /// Auto + coupon legs (amounts, %, labels). Shape: OrderDiscountBreakdown in lib/discounts.ts
  discountBreakdown  Json?
  totalAmount        Decimal
  // Jewellery deposit model: customer pays grandTotal = totalAmount * 1.05,
  // depositAmount (5%) is refunded after delivery
  depositAmount Decimal      @default(0)
  grandTotal    Decimal      @default(0)
  contactName   String       @default("")
  contactPhone  String       @default("")
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  pincode       String
  country            String        @default("IN")
  intlReviewRequired Boolean       @default(false)
  intlReviewApproved Boolean       @default(false)
  payment       Payment?
  events        OrderEvent[]
  parentOrderId String?
  quotationId   String?      @unique // informational only — no FK, quote machine stays independent.
                                      // @unique is a defense-in-depth backstop against a duplicate
                                      // order slipping through; the real race guard is the
                                      // conditional updateMany in app/api/admin/orders/route.ts.
  parent        Order?       @relation("OrderSplit", fields: [parentOrderId], references: [id])
  children      Order[]      @relation("OrderSplit")
  refunds       OrderRefund[]
  notes         OrderNote[]
  shipments            Shipment[]
  finance              OrderFinance?
  financeTransactions  FinanceTransactionOrder[]
  financeAllocations   FinanceAllocation[]
  invoices             Invoice[]
  inventoryAllocations InventoryAllocation[]
  inventorySales       InventorySale[]
  attachments          OrderAttachment[]
  // Offline/manual settlement date — preferred invoice Received On when set.
  paymentReceivedAt    DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id])
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  quantity     Int
  /// Unit retail total (incl. GST) at create time — same as priceBreakdown.total when formula-priced.
  price        Decimal
  /// Full pricing snapshot at create time (gold rate, gold/wastage/making/stones/GST). Null on legacy rows. Shape: OrderItemPriceSnapshot in lib/pricing.ts
  priceBreakdown Json?
  /// Admin-only physical build (metal, weight, stones). Not customer-visible. Shape: OrderItemInternalBuild in lib/order-internal-build.ts
  internalBuild Json?
  productName  String
  withExchange Boolean        @default(false)
  inventoryAllocations InventoryAllocation[]
}

/// Admin-only files on a manual/store order (images + PDF). Never exposed to customers.
model OrderAttachment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url         String
  fileName    String
  contentType String   @default("")
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpayRefundId  String?
  refundedAmount    Decimal       @default(0)
  status            PaymentStatus @default(CREATED)
  amount            Decimal
  createdAt         DateTime      @default(now())
}

model Shipment {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id])
  shiprocketId String?
  awbCode      String?
  courierName  String?
  trackingUrl  String?
  status       String?
  attempts     Int       @default(0)
  outcome      String?   // DELIVERED | FAILED | RTO — null while in flight
  dispatchedAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([orderId, dispatchedAt])
}

model OrderRefund {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id])
  amount          Decimal
  kind            RefundKind
  method          RefundMethod
  gatewayRefundId String?      @unique
  reason          String
  status          RefundStatus @default(INITIATED)
  createdAt       DateTime     @default(now())

  @@index([orderId])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author    String
  body      String
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model SiteBanner {
  id        String   @id @default(cuid())
  slot      String   @unique
  title     String?
  subtitle  String?
  imageUrl  String?
  /// Ordered hero / carousel images — unlimited. Prefer over imageUrl when non-empty.
  images    String[] @default([])
  /// Per-slide focal points aligned with images[]: { webX, webY, mobileX, mobileY } (0–100).
  imageFits Json     @default("[]")
  linkUrl   String?
  ctaLabel  String?
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ── Commerce v2: promos, contact, reviews ────────────────────────────────────

enum PromoKind {
  PERCENT
  FLAT
  /// Discount = GST-inclusive delivery (miscCharges) on eligible lines.
  FREE_DELIVERY
  /// % off GST-inclusive making on eligible lines (capped by making + maxDiscount).
  MAKING_PERCENT
  /// Flat ₹ off GST-inclusive making on eligible lines (capped by making).
  MAKING_FLAT
}

model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique // stored uppercase
  description    String?
  kind           PromoKind
  /// Ignored for FREE_DELIVERY (store 0). Otherwise % or ₹ depending on kind.
  value          Decimal           @default(0)
  minOrderValue  Decimal           @default(0)
  maxDiscount    Decimal? // cap for PERCENT / MAKING_PERCENT
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int?
  maxPerUser     Int               @default(1)
  /// Only valid if the user has never successfully paid for an order.
  firstOrderOnly Boolean           @default(false)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  redemptions    PromoRedemption[]
  orders         Order[]
  // Empty scope joins = whole cart (backward compatible).
  products         PromoCodeProduct[]
  collections      PromoCodeCollection[]
  storeCategories  PromoCodeStoreCategory[]
  categories       PromoCodeCategory[]
}

model PromoCodeProduct {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, productId])
  @@index([productId])
}

model PromoCodeCollection {
  id           String     @id @default(cuid())
  promoCodeId  String
  promoCode    PromoCode  @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, collectionId])
  @@index([collectionId])
}

model PromoCodeStoreCategory {
  id              String        @id @default(cuid())
  promoCodeId     String
  promoCode       PromoCode     @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  storeCategoryId String
  storeCategory   StoreCategory @relation(fields: [storeCategoryId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, storeCategoryId])
  @@index([storeCategoryId])
}

model PromoCodeCategory {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  category    Category

  @@unique([promoCodeId, category])
}

/// Automatic (no-code) % discount. Empty scope = all products.
model AutomaticDiscount {
  id          String    @id @default(cuid())
  name        String
  /// Customer-facing reason shown on PDP (e.g. "Festive edit"). Falls back to name when null.
  displayName String?
  active      Boolean   @default(true)
  percent     Decimal
  maxDiscount Decimal?
  startsAt    DateTime?
  endsAt      DateTime?
  /// Higher wins when multiple rules match a line.
  priority    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products         AutomaticDiscountProduct[]
  collections      AutomaticDiscountCollection[]
  storeCategories  AutomaticDiscountStoreCategory[]
  categories       AutomaticDiscountCategory[]
}

model AutomaticDiscountProduct {
  id                  String            @id @default(cuid())
  automaticDiscountId String
  automaticDiscount   AutomaticDiscount @relation(fields: [automaticDiscountId], references: [id], onDelete: Cascade)
  productId           String
  product             Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([automaticDiscountId, productId])
  @@index([productId])
}

model AutomaticDiscountCollection {
  id                  String            @id @default(cuid())
  automaticDiscountId String
  automaticDiscount   AutomaticDiscount @relation(fields: [automaticDiscountId], references: [id], onDelete: Cascade)
  collectionId        String
  collection          Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([automaticDiscountId, collectionId])
  @@index([collectionId])
}

model AutomaticDiscountStoreCategory {
  id                  String            @id @default(cuid())
  automaticDiscountId String
  automaticDiscount   AutomaticDiscount @relation(fields: [automaticDiscountId], references: [id], onDelete: Cascade)
  storeCategoryId     String
  storeCategory       StoreCategory     @relation(fields: [storeCategoryId], references: [id], onDelete: Cascade)

  @@unique([automaticDiscountId, storeCategoryId])
  @@index([storeCategoryId])
}

model AutomaticDiscountCategory {
  id                  String            @id @default(cuid())
  automaticDiscountId String
  automaticDiscount   AutomaticDiscount @relation(fields: [automaticDiscountId], references: [id], onDelete: Cascade)
  category            Category

  @@unique([automaticDiscountId, category])
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  userId      String
  orderId     String    @unique
  amount      Decimal
  createdAt   DateTime  @default(now())

  @@index([promoCodeId, userId])
}

enum ContactStatus {
  NEW
  RESPONDED
  CLOSED
}

model ContactRequest {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  /// Set when the reviewer has a DELIVERED order containing this product.
  orderId    String?
  rating     Int
  title      String?
  body       String
  images     String[]     @default([])
  status     ReviewStatus @default(PENDING)
  adminReply String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([userId, productId])
  @@index([productId, status])
}

// ── CMS: collections + home sections ────────────────────────────────────────

enum CollectionCoverMode {
  CUSTOM
  COLLAGE
}

model Collection {
  id             String              @id @default(cuid())
  slug           String              @unique
  title          String
  subtitle       String?
  description    String?
  heroImages     String[]            @default([])
  /// CUSTOM = heroImages[0] as face; COLLAGE = live grid of product front images.
  coverMode      CollectionCoverMode @default(CUSTOM)
  seoTitle       String?
  seoDescription String?
  active         Boolean             @default(true)
  showInNav      Boolean             @default(false)
  sortOrder      Int                 @default(0)
  updatedAt      DateTime            @updatedAt
  products            CollectionProduct[]
  automaticDiscounts  AutomaticDiscountCollection[]
  promoCodes          PromoCodeCollection[]
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@unique([collectionId, productId])
  @@index([collectionId, sortOrder])
}

// ── Store Categories: customizable categories with header toggle ────────────

model StoreCategory {
  id           String                 @id @default(cuid())
  slug         String                 @unique
  name         String
  description  String?
  image        String?
  showInHeader Boolean                @default(true)
  sortOrder    Int                    @default(0)
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  products           StoreCategoryProduct[]
  automaticDiscounts AutomaticDiscountStoreCategory[]
  promoCodes         PromoCodeStoreCategory[]
}

model StoreCategoryProduct {
  id         String        @id @default(cuid())
  categoryId String
  category   StoreCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder  Int           @default(0)

  @@unique([categoryId, productId])
  @@index([categoryId, sortOrder])
}

/// Ordered, schedulable home page sections. `config` is a per-kind payload:
/// hero {images,fits,cta}, collection-rail {collectionSlug,limit},
/// editorial {image,heading,body,ctaLabel,ctaHref}, video {url,poster},
/// usp {items[]}, testimonials {items[]}, category-tiles {categories[]}.
model HomeSection {
  id        String    @id @default(cuid())
  kind      String
  title     String?
  subtitle  String?
  config    Json      @default("{}")
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  updatedAt DateTime  @updatedAt

  @@index([active, sortOrder])
}

// ── Analytics (first-party) ──────────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String // page_view | pdp_view | add_to_cart | search | begin_checkout | purchase
  path      String?
  productId String?
  userId    String?
  sessionId String?
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([productId, name])
}

// ── Catalogue reel (Instagram-style) ─────────────────────────────────────────

model GuestUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  phone        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  progress  CatalogueProgress?
  reactions CatalogueReaction[]
  comments  CatalogueComment[]
}

model CatalogueProgress {
  id             String    @id @default(cuid())
  guestUserId    String    @unique
  guestUser      GuestUser @relation(fields: [guestUserId], references: [id], onDelete: Cascade)
  lastFrameIndex Int       @default(-1)
  updatedAt      DateTime  @updatedAt
}

model CatalogueReaction {
  id          String    @id @default(cuid())
  guestUserId String
  guestUser   GuestUser @relation(fields: [guestUserId], references: [id], onDelete: Cascade)
  productId   String
  reaction    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([guestUserId, productId])
}

model CatalogueComment {
  id          String    @id @default(cuid())
  guestUserId String
  guestUser   GuestUser @relation(fields: [guestUserId], references: [id], onDelete: Cascade)
  productId   String
  body        String
  createdAt   DateTime  @default(now())
}

enum InvoiceStatus {
  UNPAID
  PAID
}

model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id])
  status       InvoiceStatus @default(UNPAID)
  /// Full document snapshot: seller, parties, lines, payment, notes.
  payload      Json
  taxableValue Decimal
  gstAmount    Decimal
  grandTotal   Decimal
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([orderId])
  @@index([createdAt])
}

// ── Quotations ───────────────────────────────────────────────────────────────

enum QuotationSource {
  MANUAL
  WEBSITE
}

enum QuotationStatus {
  REQUESTED
  QUOTED
  CONVERTED
  CANCELLED
}

enum QuotationOrderType {
  VAIRIS
  CUSTOMISATION
}

model Quotation {
  id                  String             @id @default(cuid())
  displayId           String             @unique // "Q-7K2M"
  source              QuotationSource
  status              QuotationStatus    @default(REQUESTED)
  orderType           QuotationOrderType
  details             String?
  customerName        String?
  customerMobile      String?
  productId           String?            // optional picker link, no relation enforced
  screenshotUrls      String[]           @default([])
  discordThreadId     String?
  lastReminderAt      DateTime?
  reminderCount       Int                @default(0) // pings sent while REQUESTED; drives escalation
  escalatedAt         DateTime?          // set once, when reminderCount crosses the threshold
  quotedAmount        Int?
  quotedNotes         String?
  quotedAt            DateTime?          // set on REQUESTED->QUOTED transition; staleness clock for QUOTED
  orderId             String?            @unique // set on CONVERTED
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([customerMobile, status]) // dedup/attach lookups
}

model HeroImage {
  id        String   @id @default(cuid())
  url       String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_images")
}

enum FinancePaidThrough {
  VAIRIS_BANK
  PERSONAL_FUNDS
}

enum FinanceAccountType {
  PARTNER
  COMPANY_BANK
  CASH
  VENDOR
  /// Physical gold held (transaction amounts are grams).
  VAULT
  OTHER
}

/// How vendor wallet outflow is computed on the finance dashboard.
enum VendorOutflowSource {
  ORDER_SHEETS
  TRANSACTIONS
  BOTH
}

enum FinanceContactType {
  CUSTOMER
  VENDOR
  OTHER
}

enum FinanceTransactionDirection {
  INFLOW
  OUTFLOW
  TRANSFER
}

/// Config: wallets / people money can sit with. Email ties login → default account.
model FinanceAccount {
  id             String             @id @default(cuid())
  name           String
  email          String?            @unique
  type           FinanceAccountType
  /// Grouped under Vendor wallets on dashboard By account (and Config list).
  isVendorWallet Boolean            @default(false)
  /// Vendor only: outflow from order-sheet CP vs cashbook OUTFLOW txns (dashboard By account).
  vendorOutflowSource VendorOutflowSource @default(ORDER_SHEETS)
  /// Vault only: gold purity in karat (e.g. 24, 22, 18). Value = grams × live24K × (purity/24).
  vaultPurityK     Float                @default(24)
  active         Boolean            @default(true)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  expensesAsAccount GeneralExpense[]     @relation("ExpenseAccount")
  orderSheetsPaidTo OrderFinance[]       @relation("OrderPaidToAccount")
  orderSheetsPurchaseFrom OrderFinance[] @relation("OrderPurchaseFromAccount")
  transactionsHandled FinanceTransaction[] @relation("TxHandledBy")
  transactionsPaidThrough FinanceTransaction[] @relation("TxPaidThrough")
  transactionsTransferTo FinanceTransaction[] @relation("TxTransferTo")
}

/// Config: customers / vendors / other counterparties on transactions.
model FinanceContact {
  id        String             @id @default(cuid())
  name      String
  type      FinanceContactType @default(OTHER)
  email     String?
  phone     String?
  notes     String?
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  transactions FinanceTransaction[]
  purchaseBills PurchaseBill[]
}

/// Singleton config for finance dashboard KPI category filters (id = 1).
/// Empty arrays = legacy defaults (all matching direction / opex heuristics).
model FinanceSettings {
  id                         Int      @id @default(1)
  cashInflowCategoryIds      String[] @default([])
  generalExpenseCategoryIds  String[] @default([])
  updatedAt                  DateTime @updatedAt
}

/// Config: expense/income categories for cashbook transactions.
model FinanceCategory {
  id        String                       @id @default(cuid())
  name      String
  direction FinanceTransactionDirection
  active    Boolean                      @default(true)
  sortOrder Int                          @default(0)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  transactions FinanceTransaction[]

  @@unique([name, direction])
  @@index([direction, active])
}

/// Operating spend, not tied to an order.
/// account = who is accountable; paidThrough = which wallet actually moved.
model GeneralExpense {
  id          String              @id @default(cuid())
  date        DateTime
  description String
  amount      Decimal
  paidThrough FinancePaidThrough
  accountId   String?
  account     FinanceAccount?     @relation("ExpenseAccount", fields: [accountId], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([date])
  @@index([accountId])
}

/// One CP/SP sheet per store Order. Totals = sum of line items.
/// paidToAccount = where customer cash landed (not profit).
/// purchaseFromAccount = vendor wallet the purchase (CP) is attributed to (dashboard outflow).
model OrderFinance {
  id                    String             @id @default(cuid())
  orderId               String             @unique
  order                 Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paidToAccountId       String
  paidToAccount         FinanceAccount     @relation("OrderPaidToAccount", fields: [paidToAccountId], references: [id])
  purchaseFromAccountId String?
  purchaseFromAccount   FinanceAccount?    @relation("OrderPurchaseFromAccount", fields: [purchaseFromAccountId], references: [id])
  /// When true, selling total is rounded to the nearest rupee (invoice-style round off).
  roundOffEnabled       Boolean            @default(false)
  /// Manual override: treat as Settled even if funds are not yet in COMPANY_BANK.
  manuallySettledAt     DateTime?
  manuallySettledNote   String             @default("")
  manuallySettledBy     String?
  /// Reconciliation: Fully Paid but not Settled — ops marked the settlement exception reviewed.
  settlementExceptionReviewedAt DateTime?
  settlementExceptionReviewedBy String?
  lines                 OrderFinanceLine[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([createdAt])
  @@index([paidToAccountId])
  @@index([purchaseFromAccountId])
}

enum FinanceLineKind {
  DELIVERY
  GST
  GOLD
  STONES
  DIAMONDS
  MAKING_CHARGES
  WASTAGE_CHARGES
  CERTIFICATION
  PACKAGING
  MISC
  DISCOUNT
}

model OrderFinanceLine {
  id            String           @id @default(cuid())
  sheetId       String
  sheet         OrderFinance     @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  kind          FinanceLineKind
  costPrice     Decimal
  sellingPrice  Decimal
  sortOrder     Int              @default(0)

  @@index([sheetId])
}

/// Cashbook row: inflow, outflow, or transfer between wallets.
/// account = who handled; paidThroughAccount = wallet used (From on transfer).
/// transferToAccount = To wallet when direction is TRANSFER.
/// contactId optional; contactName stores selected contact name or free text.
model FinanceTransaction {
  id                   String                       @id @default(cuid())
  date                 DateTime
  direction            FinanceTransactionDirection
  amount               Decimal
  /// GST portion of this cashbook line (INR). Amount remains the total moved.
  gstAmount            Decimal                      @default(0)
  description          String                       @default("")
  accountId            String
  account              FinanceAccount               @relation("TxHandledBy", fields: [accountId], references: [id])
  paidThroughAccountId String
  paidThroughAccount   FinanceAccount               @relation("TxPaidThrough", fields: [paidThroughAccountId], references: [id])
  transferToAccountId  String?
  transferToAccount    FinanceAccount?              @relation("TxTransferTo", fields: [transferToAccountId], references: [id])
  categoryId           String?
  category             FinanceCategory?             @relation(fields: [categoryId], references: [id])
  contactId            String?
  contact              FinanceContact?              @relation(fields: [contactId], references: [id])
  contactName          String                       @default("")
  /// Set when created from payment confirmation (not manual cashbook entry).
  autoCreated          Boolean                      @default(false)
  /// false = For review (default for auto-created); true = Reviewed (default for manual).
  reviewComplete       Boolean                      @default(false)
  /// Free-text order references when no store order exists to link.
  unlinkedOrderLabels  String[]                     @default([])
  /// Free-text inventory references when no inventory item is linked.
  unlinkedInventoryLabels String[]                  @default([])
  orders               FinanceTransactionOrder[]
  inventoryItems       FinanceTransactionInventory[]
  allocations          FinanceAllocation[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([date])
  @@index([accountId])
  @@index([paidThroughAccountId])
  @@index([transferToAccountId])
  @@index([categoryId])
  @@index([contactId])
  @@index([autoCreated, reviewComplete, createdAt])
}

/// Applies cashbook amount to an order invoice (AR) or purchase bill (AP).
model FinanceAllocation {
  id             String             @id @default(cuid())
  transactionId  String
  transaction    FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount         Decimal
  orderId        String?
  order          Order?             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  purchaseBillId String?
  purchaseBill   PurchaseBill?      @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([transactionId])
  @@index([orderId])
  @@index([purchaseBillId])
}

/// Supplier purchase invoice / bill (AP document).
model PurchaseBill {
  id                String                   @id @default(cuid())
  /// Supplier's invoice / bill number (optional).
  billNumber        String                   @default("")
  date              DateTime
  supplierContactId String?
  supplierContact   FinanceContact?          @relation(fields: [supplierContactId], references: [id], onDelete: SetNull)
  /// Denormalized / free-text supplier name.
  supplierName      String                   @default("")
  description       String                   @default("")
  /// Optional GST portion of totalAmount.
  gstAmount         Decimal                  @default(0)
  /// Total amount owed on this bill (INR).
  totalAmount       Decimal
  notes             String                   @default("")
  lines             PurchaseBillLine[]
  attachments       PurchaseBillAttachment[]
  allocations       FinanceAllocation[]
  inventoryItems    InventoryItemPurchaseBill[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([date])
  @@index([supplierContactId])
  @@index([billNumber])
}

model PurchaseBillLine {
  id          String       @id @default(cuid())
  billId      String
  bill        PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String       @default("")
  amount      Decimal
  sortOrder   Int          @default(0)

  @@index([billId])
}

model PurchaseBillAttachment {
  id          String       @id @default(cuid())
  billId      String
  bill        PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  url         String
  fileName    String
  contentType String       @default("")
  createdAt   DateTime     @default(now())

  @@index([billId])
}

model FinanceTransactionOrder {
  id            String             @id @default(cuid())
  transactionId String
  transaction   FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([transactionId, orderId])
  @@index([orderId])
}

model FinanceTransactionInventory {
  id              String             @id @default(cuid())
  transactionId   String
  transaction     FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([transactionId, inventoryItemId])
  @@index([inventoryItemId])
}

/// Append-only log of finance section mutations (who changed what).
model FinanceAuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorEmail  String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  /// Human label for the touched row (contact name, account name, order sheet, etc.).
  objectLabel String   @default("")
  /// Optional deep link into the finance UI for that object.
  objectHref  String?
  summary     String
  before      Json?
  after       Json?

  @@index([createdAt])
  @@index([entityType, createdAt])
  @@index([actorEmail, createdAt])
}

/// Physical stock location (workshop, store, karigar, etc.).
model InventoryHolder {
  id        String          @id @default(cuid())
  name      String
  active    Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     InventoryItem[]

  @@index([active, sortOrder])
}

/// On-hand stock — linked to catalogue variant when sellable via manual order.
model InventoryItem {
  id                String                @id @default(cuid())
  productId         String?
  product           Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId         String?
  variant           ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  customName        String?
  customDescription String?
  metalPurity       String?
  weightGrams       Decimal?
  /// Total diamond weight (carats) — physical breakup, not amounts.
  diamondCarats     Decimal?
  /// Other stone weight (carats) — physical breakup, not amounts.
  stoneCarats       Decimal?
  /// Cost basis per unit (INR) — used for stock valuation.
  purchasePrice     Decimal?
  /// Selling price per unit (INR); catalogue lines may use live price when unset.
  soldPrice         Decimal?
  /// Expected sale price (INR) for stock valuation header; falls back to live then purchase.
  potentialPrice    Decimal?
  qtyOnHand         Int                   @default(0)
  holderId          String
  holder            InventoryHolder       @relation(fields: [holderId], references: [id])
  notes             String?
  allocations       InventoryAllocation[]
  sales             InventorySale[]
  financeLinks      FinanceTransactionInventory[]
  purchaseBills     InventoryItemPurchaseBill[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([holderId])
  @@index([productId])
  @@index([variantId])
  @@index([qtyOnHand])
}

/// Links an inventory item to one or more supplier purchase bills.
model InventoryItemPurchaseBill {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  purchaseBillId  String
  purchaseBill    PurchaseBill  @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([inventoryItemId, purchaseBillId])
  @@index([purchaseBillId])
}

/// Stock consumed by a manual admin order (not online checkout).
model InventoryAllocation {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId     String?
  orderItem       OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  qty             Int
  createdAt       DateTime      @default(now())

  @@index([inventoryItemId])
  @@index([orderId])
  @@index([orderItemId])
}

/// Manual mark-as-sold (order link or free-text reference).
model InventorySale {
  id                 String        @id @default(cuid())
  inventoryItemId    String
  inventoryItem      InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  qty                Int
  orderId            String?
  order              Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// Free-text order reference when no store order is linked.
  unlinkedOrderLabel String?
  soldAt             DateTime      @default(now())
  createdAt          DateTime      @default(now())

  @@index([inventoryItemId])
  @@index([orderId])
}

/// Append-only log of inventory section mutations (who changed what).
model InventoryAuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorEmail  String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  objectLabel String   @default("")
  objectHref  String?
  summary     String
  before      Json?
  after       Json?

  @@index([createdAt])
  @@index([entityType, createdAt])
  @@index([actorEmail, createdAt])
}
