generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase requires direct connection URL for migrations (not the pooler)
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Category {
  RINGS
  EARRINGS
  PENDANTS
  BRACELETS
  NECKLACES
}

enum MetalType {
  GOLD_14K
  GOLD_18K
  ROSE_GOLD
}

enum ProductStatus {
  DRAFT
  AI_DRAFT
  LIVE
}

enum OrderStatus {
  PAYMENT_PENDING
  PAYMENT_EXPIRED
  PAYMENT_CONFIRMED
  PREPARING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERY_FAILED
  RETURNING_TO_ORIGIN
  RTO_RECEIVED
  DELIVERED
  DEPOSIT_REFUNDED
  RETURN_REQUESTED
  RETURN_IN_TRANSIT
  RETURN_RECEIVED
  CANCELLED
  REFUNDED
  SPLIT_INTO_DELIVERIES
  FAILED_OTHER
}

enum RefundKind {
  DEPOSIT
  FULL
  PARTIAL
}

enum RefundMethod {
  GATEWAY
  OFFLINE
}

enum RefundStatus {
  INITIATED
  COMPLETED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  mobile    String?
  googleId  String?    @unique
  createdAt DateTime   @default(now())
  addresses Address[]
  orders    Order[]
  cartItems CartItem[]
  wishlists Wishlist[]
  reviews   Review[]
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  label        String? // "Home", "Office"
  contactName  String  @default("")
  contactPhone String  @default("")
  line1        String
  line2        String?
  city         String
  state        String
  pincode      String
  isDefault    Boolean @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Product {
  id          String           @id @default(cuid())
  name        String
  description String
  category    Category
  images      String[]
  basePrice   Decimal          @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())

  // Design identity
  itemCode    String?          @unique
  designStyle String?

  // Physical dimensions
  totalLengthMm Decimal?
  motifSizeMm   Decimal?
  thicknessMm   Decimal?

  // Gemstone details
  stoneType   String?
  stoneShape  String?
  stoneDimMm  String?
  gemCount    Int?
  caratWeight Decimal?

  comingSoon  Boolean          @default(false)
  status      ProductStatus    @default(DRAFT)
  /// Per-product override of PricingSettings.showPricesGlobal. INHERIT (default)
  /// follows the global toggle; SHOW/HIDE always win regardless of it.
  priceVisibility PriceVisibility @default(INHERIT)

  variants    ProductVariant[]
  stones      ProductStone[]
  wishlists   Wishlist[]
  reviews     Review[]
  collections CollectionProduct[]
}

/// Per-carat diamond pricing — one row per diamond type, two rates each
/// (with / without exchange). Admin-editable at /admin/settings/pricing.
model DiamondRate {
  id                   String         @id @default(cuid())
  code                 String         @unique
  label                String
  ratePerCarat         Decimal
  ratePerCaratExchange Decimal
  sortOrder            Int            @default(0)
  active               Boolean        @default(true)
  updatedAt            DateTime       @updatedAt
  stones               ProductStone[]
}

/// A stone entry on a product: type + carat (+ optional count/label).
/// Customer always sees type + carat; count/label optional.
model ProductStone {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  diamondRateId String
  diamondRate   DiamondRate @relation(fields: [diamondRateId], references: [id])
  caratWeight   Decimal
  count         Int?
  label         String?
  sortOrder     Int         @default(0)

  @@index([productId, sortOrder])
}

/// Singleton (id=1). VA = Value Addition — disclosed % line on the price
/// breakup applied to gold value and stone value. Label admin-editable.
model PricingSettings {
  id         Int      @id @default(1)
  vaGoldPct  Decimal  @default(5)
  vaStonePct Decimal  @default(5)
  vaLabel    String   @default("Value Addition")
  /// Storefront-wide default for whether prices are shown at all. Many
  /// products (no finalized diamond/gold cost yet) should read
  /// "Price on Request" instead of a computed number — Product.priceVisibility
  /// can override this per product.
  showPricesGlobal Boolean @default(true)
  updatedAt  DateTime @updatedAt
}

enum PriceVisibility {
  INHERIT
  SHOW
  HIDE
}

model ProductVariant {
  id                  String      @id @default(cuid())
  productId           String
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  metalType           MetalType
  size                String?
  weightGrams         Decimal
  makingChargePerGram Decimal     @default(0)
  flatMakingCharge    Decimal     @default(0)
  stoneCharges        Decimal     @default(0)
  miscCharges         Decimal     @default(0)
  stock               Int         @default(0)
  sku                 String      @unique
  cartItems           CartItem[]
  orderItems          OrderItem[]
}

model GoldRate {
  metalType   MetalType
  ratePerGram Decimal
  fetchedAt   DateTime  @updatedAt

  @@id([metalType])
}

model CartItem {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  quantity     Int
  withExchange Boolean        @default(false)

  @@unique([userId, variantId, withExchange])
}

model Order {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  items          OrderItem[]
  status         OrderStatus  @default(PAYMENT_PENDING)
  promoCodeId    String?
  promoCode      PromoCode?   @relation(fields: [promoCodeId], references: [id])
  discountAmount Decimal      @default(0)
  totalAmount   Decimal
  // Jewellery deposit model: customer pays grandTotal = totalAmount * 1.05,
  // depositAmount (5%) is refunded after delivery
  depositAmount Decimal      @default(0)
  grandTotal    Decimal      @default(0)
  contactName   String       @default("")
  contactPhone  String       @default("")
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  pincode       String
  payment       Payment?
  events        OrderEvent[]
  parentOrderId String?
  quotationId   String?      @unique // informational only — no FK, quote machine stays independent.
                                      // @unique is a defense-in-depth backstop against a duplicate
                                      // order slipping through; the real race guard is the
                                      // conditional updateMany in app/api/admin/orders/route.ts.
  parent        Order?       @relation("OrderSplit", fields: [parentOrderId], references: [id])
  children      Order[]      @relation("OrderSplit")
  refunds       OrderRefund[]
  notes         OrderNote[]
  shipments     Shipment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id])
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  quantity     Int
  price        Decimal
  productName  String
  withExchange Boolean        @default(false)
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpayRefundId  String?
  refundedAmount    Decimal       @default(0)
  status            PaymentStatus @default(CREATED)
  amount            Decimal
  createdAt         DateTime      @default(now())
}

model Shipment {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id])
  shiprocketId String?
  awbCode      String?
  courierName  String?
  trackingUrl  String?
  status       String?
  attempts     Int       @default(0)
  outcome      String?   // DELIVERED | FAILED | RTO — null while in flight
  dispatchedAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([orderId, dispatchedAt])
}

model OrderRefund {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id])
  amount          Decimal
  kind            RefundKind
  method          RefundMethod
  gatewayRefundId String?      @unique
  reason          String
  status          RefundStatus @default(INITIATED)
  createdAt       DateTime     @default(now())

  @@index([orderId])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author    String
  body      String
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model SiteBanner {
  id        String   @id @default(cuid())
  slot      String   @unique
  title     String?
  subtitle  String?
  imageUrl  String?
  /// Ordered hero / carousel images — unlimited. Prefer over imageUrl when non-empty.
  images    String[] @default([])
  /// Per-slide focal points aligned with images[]: { webX, webY, mobileX, mobileY } (0–100).
  imageFits Json     @default("[]")
  linkUrl   String?
  ctaLabel  String?
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ── Commerce v2: promos, contact, reviews ────────────────────────────────────

enum PromoKind {
  PERCENT
  FLAT
}

model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique // stored uppercase
  description    String?
  kind           PromoKind
  value          Decimal
  minOrderValue  Decimal           @default(0)
  maxDiscount    Decimal? // cap for PERCENT codes
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int?
  maxPerUser     Int               @default(1)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  redemptions    PromoRedemption[]
  orders         Order[]
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  userId      String
  orderId     String    @unique
  amount      Decimal
  createdAt   DateTime  @default(now())

  @@index([promoCodeId, userId])
}

enum ContactStatus {
  NEW
  RESPONDED
  CLOSED
}

model ContactRequest {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  /// Set when the reviewer has a DELIVERED order containing this product.
  orderId    String?
  rating     Int
  title      String?
  body       String
  images     String[]     @default([])
  status     ReviewStatus @default(PENDING)
  adminReply String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([userId, productId])
  @@index([productId, status])
}

// ── CMS: collections + home sections ────────────────────────────────────────

model Collection {
  id             String              @id @default(cuid())
  slug           String              @unique
  title          String
  subtitle       String?
  description    String?
  heroImages     String[]            @default([])
  seoTitle       String?
  seoDescription String?
  active         Boolean             @default(true)
  showInNav      Boolean             @default(false)
  sortOrder      Int                 @default(0)
  updatedAt      DateTime            @updatedAt
  products       CollectionProduct[]
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@unique([collectionId, productId])
  @@index([collectionId, sortOrder])
}

/// Ordered, schedulable home page sections. `config` is a per-kind payload:
/// hero {images,fits,cta}, collection-rail {collectionSlug,limit},
/// editorial {image,heading,body,ctaLabel,ctaHref}, video {url,poster},
/// usp {items[]}, testimonials {items[]}, category-tiles {categories[]}.
model HomeSection {
  id        String    @id @default(cuid())
  kind      String
  title     String?
  subtitle  String?
  config    Json      @default("{}")
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  updatedAt DateTime  @updatedAt

  @@index([active, sortOrder])
}

// ── Analytics (first-party) ──────────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String // page_view | pdp_view | add_to_cart | search | begin_checkout | purchase
  path      String?
  productId String?
  userId    String?
  sessionId String?
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([productId, name])
}

// ── Catalogue reel (Instagram-style) ─────────────────────────────────────────

model GuestUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  phone        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  progress  CatalogueProgress?
  reactions CatalogueReaction[]
  comments  CatalogueComment[]
}

model CatalogueProgress {
  id             String    @id @default(cuid())
  guestUserId    String    @unique
  guestUser      GuestUser @relation(fields: [guestUserId], references: [id], onDelete: Cascade)
  lastFrameIndex Int       @default(-1)
  updatedAt      DateTime  @updatedAt
}

model CatalogueReaction {
  id          String    @id @default(cuid())
  guestUserId String
  guestUser   GuestUser @relation(fields: [guestUserId], references: [id], onDelete: Cascade)
  productId   String
  reaction    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([guestUserId, productId])
}

model CatalogueComment {
  id          String    @id @default(cuid())
  guestUserId String
  guestUser   GuestUser @relation(fields: [guestUserId], references: [id], onDelete: Cascade)
  productId   String
  body        String
  createdAt   DateTime  @default(now())
}

// ── Quotations ───────────────────────────────────────────────────────────────

enum QuotationSource {
  MANUAL
  WEBSITE
}

enum QuotationStatus {
  REQUESTED
  QUOTED
  CONVERTED
  CANCELLED
}

enum QuotationOrderType {
  VAIRIS
  CUSTOMISATION
}

model Quotation {
  id                  String             @id @default(cuid())
  displayId           String             @unique // "Q-7K2M"
  source              QuotationSource
  status              QuotationStatus    @default(REQUESTED)
  orderType           QuotationOrderType
  details             String?
  customerName        String?
  customerMobile      String?
  productId           String?            // optional picker link, no relation enforced
  screenshotUrls      String[]           @default([])
  discordThreadId     String?
  lastReminderAt      DateTime?
  reminderCount       Int                @default(0) // pings sent while REQUESTED; drives escalation
  escalatedAt         DateTime?          // set once, when reminderCount crosses the threshold
  quotedAmount        Int?
  quotedNotes         String?
  quotedAt            DateTime?          // set on REQUESTED->QUOTED transition; staleness clock for QUOTED
  orderId             String?            @unique // set on CONVERTED
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([customerMobile, status]) // dedup/attach lookups
}

model HeroImage {
  id        String   @id @default(cuid())
  url       String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_images")
}
